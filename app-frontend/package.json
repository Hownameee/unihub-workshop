		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.4",
		"babel-plugin-react-compiler": "^1.0.0",
		"husky": "^9.1.7",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.2",
		"vite": "^8.2.0"
	}
